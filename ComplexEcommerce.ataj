APP ComplexEcommerce frontend react backend cloud

HAVE Product id name description price category image_url available featured stock rating reviews_count
HAVE User id email name role address phone orders_count
HAVE Order id user_id items subtotal tax shipping total status payment_id created
HAVE Cart id user_id items total created
HAVE Category id name parent_id display_order product_count
HAVE Review id product_id user_id rating comment created approved
HAVE Coupon id code discount_type discount_value valid_from valid_until active
HAVE Inventory id product_id warehouse quantity reserved
HAVE Shipping id order_id carrier tracking_number status estimated_delivery
HAVE Payment id order_id amount currency stripe_id status

SHOW Nav "ComplexEcommerce" "Home Shop Cart Orders Account Admin" "black"

SHOW Hero "Complex E-Commerce" "Full-featured platform in 8 keywords" "hero"
SHOW Button "Shop Now" "primary" ON Click DO ShowShop
SHOW Button "Cart" "ghost" ON Click DO ShowCart

SHOW Grid 4 6 "mobile:1"
SHOW Stat rating "Avg Rating" "gold"
SHOW Stat product_count "Products" "secondary"
SHOW Stat order_count "Orders" "card"
SHOW Stat user_count "Users" "card"

SHOW Grid 1 3 "mobile:1"
FOR EACH product IN Product WHEN product.available EQ true SHOW Card product.name product.price "card" ON Click DO AddToCart product.id

SHOW Form "Checkout" "Name" "Email" "Address" "Phone" "Payment" "Place Order" "primary" ON Submit DO CreateOrder

SHOW Form "Review" "Product" "Rating 1-5" "Comment" "Submit Review" "primary" ON Submit DO SubmitReview

SHOW Form "Coupon" "Code" "Apply" "primary" ON Submit DO ApplyCoupon

SHOW Footer "ComplexEcommerce 2026" "center gray"

DO GetProducts DO DB.Query "SELECT * FROM product WHERE available = true ORDER BY featured DESC" DO Cache.Set "products:cache" 1800 DO Emit products.loaded

DO GetCategories DO DB.Query "SELECT * FROM category ORDER BY display_order" DO Emit categories.loaded

DO GetCart DO DB.Query "SELECT * FROM cart WHERE user_id = Cart.user_id" DO Cache.Set "cart:cache" 600 DO Emit cart.loaded

DO GetOrders DO DB.Query "SELECT * FROM orders WHERE user_id = Order.user_id ORDER BY created DESC" DO Emit orders.loaded

DO CreateOrder DO DB.Insert "orders" Order DO Audit.Log "ORDER_CREATED" Order.id DO Emit order.created

DO SubmitReview DO DB.Insert "reviews" Review DO Audit.Log "REVIEW_SUBMITTED" Review.id DO Emit review.submitted

DO ApplyCoupon DO DB.Query "SELECT * FROM coupon WHERE code = Coupon.code AND active = true" DO Emit coupon.applied

DO AddToCart DO Cart.Add product.id DO Emit cart.updated

DO CreatePayment DO DB.Insert "payments" Payment DO Audit.Log "PAYMENT_CREATED" Payment.id DO Emit payment.created

DO UpdateInventory DO DB.Query "UPDATE inventory SET quantity = Inventory.quantity - :qty WHERE product_id = Inventory.product_id" DO Emit inventory.updated

WHEN 00:00 DO UpdateAnalytics DO DB.Query "UPDATE stats SET last_updated = NOW()" DO Emit analytics.updated

WHEN hourly DO CheckInventory DO DB.Query "SELECT * FROM inventory WHERE quantity < 10" DO Emit inventory.low_stock

WHEN daily DO GenerateReports DO DB.Query "SELECT * FROM orders WHERE created_at > NOW() - 30 days" DO Emit reports.generated