App RealtimeCollab frontend react

PAGE Editor and public
  FLEX TopBar and row items-center justify-between bg-gray-900 text-white px-4 py-2
    FLEX Left and row items-center gap-4
      CARD Logo with text "CollabEdit" font-bold text-white
      FLEX DocInfo and row items-center gap-2
        TEXT doc.name = current_doc.name
        TEXT doc.status = current_doc.status badge variant = doc.status
    FLEX Right and row items-center gap-3
      AVATAR collaborators = current_doc.collaborators size small
      TEXT online = "{current_doc.online_count} online" text-xs text-gray-400
      BUTTON Share and icon text-gray-400
  GRID Main and 3 columns gap-0
    FLEX Sidebar and col-span-1 bg-gray-800 text-white w-56 flex-col p-4
      TEXT Sections text-xs uppercase text-gray-500 tracking-wider mb-3
      FOR section in doc.sections
        FLEX SectionItem and row items-center gap-2 py-1 px-2 rounded hover:bg-gray-700 cursor-pointer
          ICON type = section.type color = section.type == "heading" ? indigo : gray
          TEXT section.name text-sm
    FLEX Editor and col-span-2 flex flex-col
      FLEX Toolbar and row items-center gap-2 bg-gray-800 px-4 py-2 border-b border-gray-700
        BUTTON Bold and icon B
        BUTTON Italic and icon I
        BUTTON Underline and icon U
        SEPARATOR
        BUTTON H1 and text-xs text-gray-400 hover:text-white H1
        BUTTON H2 and text-xs text-gray-400 hover:text-white H2
        SEPARATOR
        BUTTON Bullet and icon •
        BUTTON Number and icon 1.
        SEPARATOR
        SELECT font family = editor.font options = [Mono Sans Serif]
        SELECT size value = editor.fontSize options = [12 14 16 18 20 24]
      FLEX EditorArea and flex-1 p-6 bg-white text-gray-900 overflow-auto
        FOR block in doc.blocks
          BLOCK with key block.id type = block.type content = block.content
          IF block.type == "heading"
            TEXT content = block.content as heading level = block.level
          IF block.type == "paragraph"
            TEXT content = block.content as p
          IF block.type == "list"
            LIST items = block.items type = block.listType
      FLEX StatusBar and row items-center justify-between bg-gray-800 text-gray-400 px-4 py-1 text-xs
        TEXT "Words: {word_count}"
        TEXT "Saved {last_saved} ago"
        TEXT "v3.1 ATAJ"
COMPILE TO collab-editor.tsx + collab-editor.css
