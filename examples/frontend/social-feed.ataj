APP SocialFeed frontend react

PAGE Home and public
  FLEX Header and row items-center justify-between bg-gradient-to-r from-indigo-600 to-purple-700 text-white px-6 py-4
    CARD Logo with text "SocialFeed" size large
    FLEX Search and row flex-1 max-w-md mx-8
      INPUT placeholder "Search posts..."
    NAV Right with Home Explore Notifications Messages Profile
  GRID Content and 3 columns gap-6 px-6 py-8
    CARD Feed and col-span-2
      FOR post in posts
        CARD Post with key post.id shadow rounded-lg p-4 mb-4
          FLEX PostHeader and row items-center mb-3
            AVATAR user = post.author.avatar
            TEXT author = post.author.name time = post.timestamp
          TEXT content = post.body
          IF post.media_url
            IMG src = post.media_url rounded-lg mb-3
          FLEX PostActions and row gap-4 mt-3
            BUTTON like and outline icon heart
            TEXT count = post.likes
            BUTTON comment and outline icon message
            BUTTON share and outline icon share
            BUTTON bookmark and outline icon bookmark
          IF post.replies.length > 0
            STACK Replies and vertical gap-2 mt-4 border-t pt-4
              FOR reply in post.replies
                FLEX Reply and row items-start gap-2
                  AVATAR user = reply.author.avatar size small
                  TEXT author = reply.author.name body = reply.body time = reply.timestamp
    FLEX Sidebar and col-span-1 flex-col gap-6
      CARD Suggestions with title "Who to follow"
        FOR user in suggestions
          FLEX Suggestion and row items-center justify-between
            FLEX AvatarAndName and row items-center gap-3
              AVATAR user = user.avatar size small
              TEXT name = user.name handle = "@{user.handle}"
            BUTTON follow and primary text "Follow"
      CARD Trending with title "Trending"
        FOR topic in trending
          FLEX Topic and row justify-between py-2 border-b
            TEXT tag = #{topic.tag} title = topic.title
            TEXT count = "{topic.posts} posts"
  FLEX Footer and row justify-center py-6 bg-gray-900 text-gray-400 text-sm
    TEXT "© 2026 SocialFeed. 8 keywords. 0 CVEs."

COMPILE TO social-home.tsx + social-home.css
