APP Todo frontend react

HAVE Todo text done
HAVE Todos list[Todo]
HAVE InputText text

SHOW Title "Todo List"
SHOW Input value=InputText placeholder="Add todo..." ON Enter DO Todos = Todos + [{text: InputText, done: false}]; InputText = ""
SHOW Section layout="todo-list"
  FOR EACH t IN Todos
    SHOW Checkbox checked=t.done label=t.text ON Change DO t.done = !t.done
    SHOW Button "Delete" ON Click DO Todos = Todos.filter(item => item !== t)
SHOW Footer "Items: {Todos.length}"