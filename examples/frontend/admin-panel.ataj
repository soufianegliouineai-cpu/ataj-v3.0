APP AdminPanel frontend react

PAGE Admin and role admin
  FLEX Sidebar and col-span-1 bg-gray-900 text-white w-64 min-h-screen flex flex-col
    CARD Brand and p-6 text-xl font-bold text-indigo-400 border-b border-gray-700
      TEXT "Admin"
    NAV Menu and flex-1 py-4
      ITEM Dashboard icon dashboard href /admin
      ITEM Users icon users href /admin/users
      ITEM Products icon package href /admin/products
      ITEM Orders icon shopping-cart href /admin/orders
      ITEM Analytics icon chart href /admin/analytics
      ITEM Settings icon settings href /admin/settings
    CARD Version and p-6 border-t border-gray-700
      TEXT "ATAJ v3.1"
      TEXT "9 Keywords"

  GRID Content and col-span-11 flex flex-col
    FLEX TopBar and row items-center justify-between bg-white shadow px-6 py-4
      TEXT PageTitle = current_page font-semibold text-xl
      FLEX UserMenu and row items-center gap-3
        AVATAR user = current_user
        TEXT name = current_user.name
    GRID Stats and 4 columns gap-6 mb-8 mt-6
      CARD Stat and bg-white rounded-lg shadow p-6
        TEXT label = stat.label text-sm text-gray-500
        TEXT value = stat.value text-3xl font-bold text-gray-900
        TEXT change = stat.change text-sm mt-1
      FOR stat in stats
        CARD_SMI = stat
    CARD Content and bg-white rounded-lg shadow p-6
      IF current_page == "dashboard"
        GRID Charts and 2 columns gap-6
          CARD RevenueChart with data revenue_data
          CARD UserGrowth with data user_growth_data
      IF current_page == "users"
        TABLE Users with columns Name Email Role Status Actions
      IF current_page == "products"
        TABLE Products with columns Name SKU Price Stock Category Actions
      IF current_page == "orders"
        TABLE Orders with columns ID Customer Date Total Status Actions
    FLEX Footer and row justify-between px-6 py-4 bg-gray-50 border-t border-gray-200 text-sm text-gray-500
      TEXT "ATAJ v3.1 | 9 Keywords | 200/200 Tests | 0 CVEs"
      TEXT "Warranty: \$100,000"

COMPILE TO admin.tsx + admin.css
