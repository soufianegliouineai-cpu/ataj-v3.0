APP EspaceYafaWebsite frontend react

PAGE Home and public
  FLEX Header and row items-center justify-between bg-white shadow-md px-6 py-4 sticky top-0 z-50
    CARD Brand with logo text "Espace Yafa" size 2xl font-bold text-amber-700
    FLEX Nav and row items-center gap-6
      NAV Link with Home active href / text-gray-700 hover:text-amber-700
      NAV Link with Menu href /menu text-gray-700 hover:text-amber-700
      NAV Link with Reservations href /reservations text-gray-700 hover:text-amber-700
      NAV Link with Orders href /orders text-gray-700 hover:text-amber-700
      NAV Link with Reviews href /reviews text-gray-700 hover:text-amber-700
      NAV Link with Contact href /contact text-gray-700 hover:text-amber-700
    FLEX LanguageSwitcher and row items-center gap-2
      BUTTON En with bg-amber-700 text-white px-3 py-1 rounded text-sm
      BUTTON عربي with bg-gray-200 text-gray-700 px-3 py-1 rounded text-sm
      BUTTON Fr with bg-gray-200 text-gray-700 px-3 py-1 rounded text-sm

  GRID Hero and 1 column relative h-96 mb-12
    IMG src = "https://images.unsplash.com/photo-1517248135467-4c7edcad34c4" alt = "Espace Yafa Restaurant" class = "w-full h-full object-cover"
    CARD HeroOverlay and absolute inset-0 bg-black bg-opacity-50 flex items-center justify-center
      TEXT title = "Welcome to Espace Yafa" size 5xl font-bold text-white text-center mb-4
      TEXT subtitle = "Authentic Moroccan Cuisine in the Heart of Casablanca" size xl text-white text-center mb-8
      FLEX CTA and row justify-center gap-4
        BUTTON ReserveTable with bg-amber-700 text-white px-8 py-3 rounded-lg font-semibold hover:bg-amber-800 text-lg
        BUTTON ViewMenu with bg-white text-amber-700 px-8 py-3 rounded-lg font-semibold hover:bg-gray-100 text-lg

  GRID Features and 3 columns gap-8 px-6 mb-16
    CARD Feature and bg-white rounded-xl shadow-lg p-8 text-center
      TEXT icon = "🍽️" size 4xl mb-4
      TEXT title = "Authentic Recipes" size xl font-bold text-gray-900 mb-2
      TEXT desc = "Traditional Moroccan dishes passed down through generations" text-gray-600
    CARD Feature and bg-white rounded-xl shadow-lg p-8 text-center
      TEXT icon = "🌿" size 4xl mb-4
      TEXT title = "Fresh Ingredients" size xl font-bold text-gray-900 mb-2
      TEXT desc = "Locally sourced, organic produce and spices" text-gray-600
    CARD Feature and bg-white rounded-xl shadow-lg p-8 text-center
      TEXT icon = "⭐" size 4xl mb-4
      TEXT title = "5-Star Experience" size xl font-bold text-gray-900 mb-2
      TEXT desc = "Rated #1 Moroccan restaurant in Casablanca" text-gray-600

  GRID PopularDishes and px-6 mb-16
    TEXT SectionTitle = "Popular Dishes" size 3xl font-bold text-center text-gray-900 mb-8
    GRID Dishes and 4 columns gap-6
      FOR dish in popular_dishes
        CARD DishCard and bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow cursor-pointer
          IMG src = dish.image_url alt = dish.name class = "w-full h-48 object-cover"
          CARD Body and p-4
            TEXT name = dish.name font-semibold text-lg mb-1
            TEXT name_ar = dish.name_ar text-sm text-gray-500 mb-2
            TEXT desc = dish.description text-sm text-gray-600 mb-3 line-clamp-2
            FLEX PriceAndRating and row items-center justify-between
              TEXT price = dish.price currency MAD font-bold text-lg text-amber-700
              TEXT rating = "⭐ 4.8" text-sm text-gray-600
            BUTTON OrderNow with bg-amber-700 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-amber-800 w-full mt-3

  GRID Testimonials and px-6 mb-16 bg-amber-50 py-12 rounded-2xl
    TEXT SectionTitle = "What Our Customers Say" size 3xl font-bold text-center text-gray-900 mb-8
    GRID Reviews and 3 columns gap-6
      FOR review in recent_reviews
        CARD ReviewCard and bg-white rounded-xl shadow p-6
          FLEX Rating and row items-center mb-3
            FOR star in [1,2,3,4,5]
              TEXT star = "⭐" text-sm
          TEXT comment = review.comment text-gray-700 mb-4 italic
          FLEX Customer and row items-center gap-3
            AVATAR customer = review.customer_name size small
            TEXT name = review.customer_name font-medium
            TEXT date = review.created text-sm text-gray-500

  GRID ReservationCTA and px-6 mb-16
    CARD CTA and bg-gradient-to-r from-amber-700 to-amber-900 text-white rounded-2xl p-12 text-center
      TEXT title = "Ready to Experience Authentic Moroccan Cuisine?" size 3xl font-bold mb-4
      TEXT subtitle = "Book your table now and enjoy an unforgettable dining experience" size lg mb-8
      BUTTON BookNow with bg-white text-amber-700 px-8 py-3 rounded-lg font-semibold hover:bg-gray-100 text-lg

  FLEX Footer and row justify-between items-center bg-gray-900 text-white px-6 py-8
    CARD Info and flex-1
      TEXT name = "Espace Yafa" size xl font-bold text-amber-400 mb-2
      TEXT address = "HF98+VPM, Casablanca 20250, Morocco" text-gray-300 mb-1
      TEXT phone = "+212 522-123456" text-gray-300 mb-1
      TEXT email = "info@espaceyafa.ma" text-gray-300
    CARD Hours and flex-1 text-center
      TEXT title = "Opening Hours" size lg font-semibold mb-2
      TEXT hours = "Monday - Friday: 12:00 - 22:00" text-gray-300 mb-1
      TEXT hours = "Saturday - Sunday: 11:00 - 23:00" text-gray-300 mb-1
      TEXT hours = "Ramadan: Hours may vary" text-gray-400 text-sm
    CARD Social and flex-1 text-right
      TEXT title = "Follow Us" size lg font-semibold mb-2
      FLEX Icons and row justify-end gap-4
        BUTTON Facebook with text-2xl hover:text-amber-400
        BUTTON Instagram with text-2xl hover:text-amber-400
        BUTTON WhatsApp with text-2xl hover:text-amber-400

COMPILE TO espace-yafa-home.tsx + espace-yafa-home.css

PAGE Menu and public
  FLEX Header and row items-center justify-between bg-white shadow-md px-6 py-4 sticky top-0 z-50
    CARD Brand with logo text "Espace Yafa" size 2xl font-bold text-amber-700
    NAV Links as above

  GRID MenuHero and 1 column relative h-64 mb-8
    IMG src = "https://images.unsplash.com/photo-1414235077428-338989a2e8c0" alt = "Menu" class = "w-full h-full object-cover"
    CARD Overlay and absolute inset-0 bg-black bg-opacity-50 flex items-center justify-center
      TEXT title = "Our Menu" size 4xl font-bold text-white

  FLEX MenuContent and row gap-8 px-6
    CARD Categories and w-64 bg-white rounded-xl shadow p-6 sticky top-24 h-fit
      TEXT title = "Categories" size xl font-bold mb-4
      FOR category in categories
        BUTTON CategoryBtn with w-full text-left px-4 py-2 rounded-lg mb-2 hover:bg-amber-50 category.name = category.name

    GRID Items and flex-1
      FOR category in categories
        TEXT CategoryTitle = category.name size 2xl font-bold text-gray-900 mb-4
        TEXT CategoryTitleAr = category.name_ar text-lg text-gray-500 mb-6
        GRID CategoryItems and 3 columns gap-6 mb-12
          FOR item in category.items
            CARD MenuItem and bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition
              IMG src = item.image_url alt = item.name class = "w-full h-48 object-cover"
              CARD Badge and absolute top-4 right-4 bg-amber-700 text-white px-2 py-1 rounded text-xs font-bold
                TEXT badge = item.featured ? "Featured" : ""
              CARD Body and p-4
                FLEX TitleRow and row items-start justify-between mb-2
                  TEXT name = item.name font-semibold text-lg
                  TEXT price = item.price currency MAD font-bold text-amber-700
                TEXT name_ar = item.name_ar text-sm text-gray-500 mb-2
                TEXT desc = item.description text-sm text-gray-600 mb-3 line-clamp-2
                FLEX Tags and row gap-2 mb-3
                  IF item.spicy
                    BADGE Spicy with bg-red-100 text-red-700 px-2 py-1 rounded text-xs
                  IF item.vegetarian
                    BADGE Veg with bg-green-100 text-green-700 px-2 py-1 rounded text-xs
                  IF item.gluten_free
                    BADGE GF with bg-blue-100 text-blue-700 px-2 py-1 rounded text-xs
                BUTTON AddToOrder with bg-amber-700 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-amber-800 w-full

COMPILE TO espace-yafa-menu.tsx + espace-yafa-menu.css

PAGE Reservations and public
  FLEX Header as above

  GRID Hero and 1 column relative h-64 mb-8
    IMG src = "https://images.unsplash.com/photo-1559329007-40df8a6b1edc" alt = "Reservations" class = "w-full h-full object-cover"
    CARD Overlay and absolute inset-0 bg-black bg-opacity-50 flex items-center justify-center
      TEXT title = "Make a Reservation" size 4xl font-bold text-white

  GRID ReservationForm and max-w-2xl mx-auto px-6 mb-16
    CARD Form and bg-white rounded-xl shadow-lg p-8
      TEXT title = "Book Your Table" size 2xl font-bold mb-6
      INPUT name = "customer_name" placeholder "Your Name" rounded-lg border-gray-300 mb-4
      INPUT name = "customer_phone" placeholder "Phone Number" rounded-lg border-gray-300 mb-4
      INPUT name = "email" placeholder "Email Address" type email rounded-lg border-gray-300 mb-4
      INPUT name = "party_size" placeholder "Party Size" type number min 1 max 20 rounded-lg border-gray-300 mb-4
      INPUT name = "date" placeholder "Date" type date rounded-lg border-gray-300 mb-4
      INPUT name = "time" placeholder "Time" type time rounded-lg border-gray-300 mb-4
      TEXTAREA name = "special_requests" placeholder "Special Requests (optional)" rows 4 rounded-lg border-gray-300 mb-6
      BUTTON Submit with bg-amber-700 text-white px-8 py-3 rounded-lg font-semibold hover:bg-amber-800 w-full
        TEXT Submit = "Confirm Reservation"

COMPILE TO espace-yafa-reservations.tsx + espace-yafa-reservations.css

STATE cart and []
STATE language and "en"
STATE popular_dishes with []
STATE recent_reviews with []
STATE categories with []