APP PerfumeShop frontend react backend cloud

HAVE Product id name description price category image_url available featured scent_family volume_ml
HAVE Category id name icon display_order
HAVE Cart id customer_id items total created
HAVE Customer id email name phone
HAVE Order id customer_id items subtotal tax total status order_date
HAVE Review id product_id customer_name rating comment created approved

SHOW Nav "Perfume Shop" "Home Shop New Arrivals Best Sellers About Contact" "black"

SHOW Hero "Luxury Fragrances" "Discover Your Signature Scent" "hero"
SHOW Button "Shop Now" "primary" ON Click DO ShowShop
SHOW Button "New Arrivals" "ghost" ON Click DO ShowNewArrivals

SHOW Grid 4 6 "mobile:1"
SHOW Stat featured_count "Featured" "gold"
SHOW Stat categories "Categories" "secondary"
SHOW Stat reviews "Reviews" "card"

SHOW Grid 1 3 "mobile:1"
FOR EACH product IN Product WHEN product.available EQ true SHOW Card product.name product.price "card" ON Click DO AddToCart product.id

SHOW Form "Order" "Name" "Email" "Phone" "Address" "Place Order" "primary" ON Submit DO CreateOrder

SHOW Form "Review" "Product Name" "Rating 1-5" "Comment" "Submit Review" "primary" ON Submit DO SubmitReview

SHOW Footer "Perfume Shop 2026" "center gray"

DO GetProducts DO DB.Query "SELECT * FROM product WHERE available = true ORDER BY featured DESC" DO Cache.Set "products:cache" 1800 DO Emit products.loaded

DO GetCategories DO DB.Query "SELECT * FROM category ORDER BY display_order" DO Emit categories.loaded

DO CreateOrder DO DB.Insert "orders" Order DO Audit.Log "ORDER_CREATED" Order.id DO Emit order.created

DO SubmitReview DO DB.Insert "reviews" Review DO Audit.Log "REVIEW_SUBMITTED" Review.id DO Emit review.submitted

DO AddToCart DO Cart.Add product.id DO Emit cart.updated

WHEN 00:00 DO UpdateAnalytics DO DB.Query "UPDATE stats SET last_updated = NOW()" DO Emit analytics.updated