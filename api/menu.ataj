APP EspaceYafaMenu multi-cloud aws gcp

HAVE MenuItem with id uuid name string name_ar string description text description_ar text price decimal category enum image_url string available bool featured bool spicy bool vegetarian bool gluten_free bool display_order int
HAVE Category with id uuid name string name_ar string description text icon string display_order int
HAVE DailySpecial with id uuid menu_item_id uuid day_of_week int special_price decimal available bool

USE postgres PIN 2.0.0
USE redis PIN 2.0.0
USE cloudinary PIN 1.0.0
USE audit PIN 1.0.0

SHOW FullMenu and public idempotent
SHOW MenuByCategory and public idempotent
SHOW DailySpecials and public idempotent
SHOW PopularItems and public idempotent
SHOW MenuAdmin and role admin

DO GetFullMenu and idempotent
 Call postgres.query "SELECT m.*, c.name as category_name, c.name_ar as category_name_ar FROM menu_items m JOIN categories c ON m.category = c.id WHERE m.available = true ORDER BY c.display_order, m.display_order"
 Call redis.setex key = "menu:full" ttl = 600 value = menu_items
 DO Emit menu.full_loaded

DO GetMenuByCategory and idempotent
 Call postgres.query "SELECT * FROM menu_items WHERE category = :category AND available = true ORDER BY display_order"
 DO Emit menu.category_loaded

DO GetDailySpecials and idempotent
 Call postgres.query "SELECT ds.*, m.name, m.name_ar, m.description, m.description_ar, m.image_url FROM daily_specials ds JOIN menu_items m ON ds.menu_item_id = m.id WHERE ds.day_of_week = EXTRACT(DOW FROM NOW()) AND ds.available = true"
 Call redis.setex key = "menu:daily_specials" ttl = 3600 value = daily_specials
 DO Emit menu.daily_specials_loaded

DO GetPopularItems and idempotent
 Call postgres.query "SELECT m.*, COUNT(oi.id) as order_count FROM menu_items m JOIN order_items oi ON m.id = oi.menu_item_id JOIN orders o ON oi.order_id = o.id WHERE o.created_at >= NOW() - INTERVAL '30 days' GROUP BY m.id ORDER BY order_count DESC LIMIT 10"
 DO Emit menu.popular_loaded

DO AddMenuItem and idempotent circuit approval from 1 Manager
 Call postgres.insert table = "menu_items" values = {name: MenuItem.name, name_ar: MenuItem.name_ar, description: MenuItem.description, description_ar: MenuItem.description_ar, price: MenuItem.price, category: MenuItem.category, image_url: MenuItem.image_url, available: true, featured: MenuItem.featured, spicy: MenuItem.spicy, vegetarian: MenuItem.vegetarian, gluten_free: MenuItem.gluten_free, display_order: MenuItem.display_order}
 Call cloudinary.upload image = MenuItem.image_data folder = "espace-yafa/menu"
 Call redis.del key = "menu:full"
 Call audit.log action = "MENU_ITEM_ADDED" entity = "MenuItem" id = MenuItem.id
 DO Emit menu.item_added

DO UpdateMenuItem and idempotent circuit approval from 1 Manager
 Call postgres.update table = "menu_items" set = {name: MenuItem.name, name_ar: MenuItem.name_ar, description: MenuItem.description, description_ar: MenuItem.description_ar, price: MenuItem.price, category: MenuItem.category, image_url: MenuItem.image_url, featured: MenuItem.featured, spicy: MenuItem.spicy, vegetarian: MenuItem.vegetarian, gluten_free: MenuItem.gluten_free, display_order: MenuItem.display_order} where = "id = MenuItem.id"
 Call redis.del key = "menu:full"
 Call audit.log action = "MENU_ITEM_UPDATED" entity = "MenuItem" id = MenuItem.id
 DO Emit menu.item_updated

DO ToggleAvailability and idempotent circuit
 Call postgres.update table = "menu_items" set = {available: MenuItem.available} where = "id = MenuItem.id"
 Call redis.del key = "menu:full"
 Call audit.log action = "MENU_ITEM_AVAILABILITY_TOGGLED" entity = "MenuItem" id = MenuItem.id
 DO Emit menu.availability_toggled

DO AddDailySpecial and idempotent circuit approval from 1 Manager
 Call postgres.insert table = "daily_specials" values = {menu_item_id: DailySpecial.menu_item_id, day_of_week: DailySpecial.day_of_week, special_price: DailySpecial.special_price, available: true}
 Call audit.log action = "DAILY_SPECIAL_ADDED" entity = "DailySpecial" id = DailySpecial.id
 DO Emit menu.daily_special_added

WHEN daily DO UpdateMenuCache and idempotent
 FOR EACH MenuItem IN (SELECT * FROM menu_items WHERE available = true) DO
  Call redis.setex key = "menu:item:{MenuItem.id}" ttl = 86400 value = MenuItem
 END DO
 FOR EACH Category DO
  Call redis.setex key = "menu:category:{Category.id}" ttl = 86400 value = Category
 END DO
 DO Audit and immutable

DO SeedSampleData and approval from Admin
 // Sample categories for Moroccan/Mediterranean restaurant
 Call postgres.insert table = "categories" values = {name: "Appetizers", name_ar: "المقبلات", description: "Cold and hot starters", icon: "🥗", display_order: 1}
 Call postgres.insert table = "categories" values = {name: "Main Courses", name_ar: "الأطباق الرئيسية", description: "Traditional Moroccan dishes", icon: "🍽️", display_order: 2}
 Call postgres.insert table = "categories" values = {name: "Tagines", name_ar: "الطاجين", description: "Slow-cooked traditional dishes", icon: "🥘", display_order: 3}
 Call postgres.insert table = "categories" values = {name: "Grilled Meats", name_ar: "المشاوي", description: "Fresh grilled selections", icon: "🥩", display_order: 4}
 Call postgres.insert table = "categories" values = {name: "Seafood", name_ar: "المأكولات البحرية", description: "Fresh Mediterranean seafood", icon: "🐟", display_order: 5}
 Call postgres.insert table = "categories" values = {name: "Desserts", name_ar: "الحلويات", description: "Traditional Moroccan sweets", icon: "🍰", display_order: 6}
 Call postgres.insert table = "categories" values = {name: "Beverages", name_ar: "المشروبات", description: "Refreshing drinks", icon: "🥤", display_order: 7}
 
 // Sample menu items
 Call postgres.insert table = "menu_items" values = {name: "Harira Soup", name_ar: "حساء الحريرة", description: "Traditional tomato and lentil soup with herbs", description_ar: "حساء تقليدي بالطماطم والعدس بالأعشاب", price: 45.00, category: 1, image_url: "https://images.unsplash.com/photo-1547592166-23ac45744acd", available: true, featured: true, spicy: false, vegetarian: true, gluten_free: false, display_order: 1}
 Call postgres.insert table = "menu_items" values = {name: "Moroccan Salad", name_ar: "السلطة المغربية", description: "Fresh tomatoes, cucumbers, onions with lemon dressing", description_ar: "طماطم وخيار وبصل طازج مع تتبيلة الليمون", price: 55.00, category: 1, image_url: "https://images.unsplash.com/photo-1512621776951-a57141f2eefd", available: true, featured: false, spicy: false, vegetarian: true, gluten_free: true, display_order: 2}
 Call postgres.insert table = "menu_items" values = {name: "Chicken Pastilla", name_ar: "بسطيلة الدجاج", description: "Sweet and savory pastry with shredded chicken and almonds", description_ar: "معجنات حلوة ومالحة بالدجاج المفروم واللوز", price: 120.00, category: 2, image_url: "https://images.unsplash.com/photo-1565299624946-b28f40a7ae38", available: true, featured: true, spicy: false, vegetarian: false, gluten_free: false, display_order: 1}
 Call postgres.insert table = "menu_items" values = {name: "Lamb Tagine with Prunes", name_ar: "طاجين لحم بالبرقوق", description: "Slow-cooked lamb with prunes, almonds and spices", description_ar: "لحم ضأن مطهو ببطء مع البرقوق واللوز والتوابل", price: 180.00, category: 3, image_url: "https://images.unsplash.com/photo-1504674900247-0877df9cc836", available: true, featured: true, spicy: false, vegetarian: false, gluten_free: true, display_order: 1}
 Call postgres.insert table = "menu_items" values = {name: "Fish Tagine", name_ar: "طاجين السمك", description: "Fresh fish with vegetables and chermoula sauce", description_ar: "سمك طازج مع الخضروات وصلصة الشرمولة", price: 160.00, category: 3, image_url: "https://images.unsplash.com/photo-1534422298391-e4f8c172dddb", available: true, featured: false, spicy: false, vegetarian: false, gluten_free: true, display_order: 2}
 Call postgres.insert table = "menu_items" values = {name: "Couscous Royal", name_ar: "الكسكس الملكي", description: "Steamed couscous with seven vegetables and meat", description_ar: "كسكس مطهو بالبخار مع سبعة خضروات ولحم", price: 150.00, category: 2, image_url: "https://images.unsplash.com/photo-1511690743698-d9d18f7e20f1", available: true, featured: true, spicy: false, vegetarian: false, gluten_free: false, display_order: 2}
 Call postgres.insert table = "menu_items" values = {name: "Grilled Kebab", name_ar: "كباب مشوي", description: "Marinated beef skewers with grilled vegetables", description_ar: "أسياخ لحم بقري متبل مع خضروات مشوية", price: 140.00, category: 4, image_url: "https://images.unsplash.com/photo-1529006557810-274b9b2fc783", available: true, featured: false, spicy: true, vegetarian: false, gluten_free: true, display_order: 1}
 Call postgres.insert table = "menu_items" values = {name: "Kaab el Ghazal", name_ar: "كعب الغزال", description: "Traditional gazelle horns pastry with almond filling", description_ar: "معجنات كعب الغزال التقليدية بحشوة اللوز", price: 65.00, category: 6, image_url: "https://images.unsplash.com/photo-1563805042-7684c019e1cb", available: true, featured: true, spicy: false, vegetarian: true, gluten_free: false, display_order: 1}
 Call postgres.insert table = "menu_items" values = {name: "Mint Tea", name_ar: "أتاي بالنعناع", description: "Traditional Moroccan mint tea with fresh mint", description_ar: "الشاي المغربي التقليدي بالنعناع الطازج", price: 25.00, category: 7, image_url: "https://images.unsplash.com/photo-1556679343-c7306c1976bc", available: true, featured: true, spicy: false, vegetarian: true, gluten_free: true, display_order: 1}
 
 DO Emit menu.sample_data_seeded