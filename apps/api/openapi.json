{
  "openapi": "3.1.0",
  "info": {
    "title": "LifeOS AI Nest API",
    "version": "0.3.0",
    "description": "Provider-neutral NestJS API target. Persistent writes require verified OIDC JWTs and PostgreSQL RLS. Upload metadata is supported, but byte transport, malware scanning, OCR, and a public production hostname are not configured yet."
  },
  "servers": [
    {
      "url": "http://localhost:3000/v1",
      "description": "Verified container/local API. Public production hostname not deployed yet."
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service health"
          }
        }
      }
    },
    "/readiness": {
      "get": {
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "Runtime capability and dependency readiness"
          }
        }
      }
    },
    "/version": {
      "get": {
        "operationId": "getVersion",
        "responses": {
          "200": {
            "description": "API version"
          }
        }
      }
    },
    "/document-types": {
      "get": {
        "operationId": "listDocumentTypes",
        "responses": {
          "200": {
            "description": "Supported document types"
          }
        }
      }
    },
    "/protection/expiry": {
      "post": {
        "operationId": "calculateExpiryProtection",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExpiryProtectionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Stateless expiry protection calculated"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/households/{householdId}/protection/expiry": {
      "post": {
        "operationId": "persistExpiryProtection",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "householdId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersistExpiryProtectionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Protection graph persisted atomically"
          },
          "400": {
            "description": "Validation or idempotency error"
          },
          "401": {
            "description": "Bearer token missing or invalid"
          },
          "403": {
            "description": "RLS denied access to household"
          },
          "503": {
            "description": "OIDC or persistence dependency not configured"
          }
        }
      }
    },
    "/households": {
      "get": {
        "operationId": "listHouseholds",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Households visible to the verified user"
          },
          "401": {
            "description": "Bearer token missing or invalid"
          },
          "503": {
            "description": "OIDC or persistence dependency not configured"
          }
        }
      },
      "post": {
        "operationId": "createHousehold",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "homeJurisdiction": {
                    "type": "string",
                    "maxLength": 32
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Household created and caller added as owner"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Bearer token missing or invalid"
          },
          "503": {
            "description": "Persistence not configured"
          }
        }
      }
    },
    "/households/{householdId}/people": {
      "get": {
        "operationId": "listPeople",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "householdId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "People metadata visible through household RLS"
          },
          "401": {
            "description": "Bearer token missing or invalid"
          }
        }
      },
      "post": {
        "operationId": "createPerson",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "householdId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Person metadata created"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Bearer token missing or invalid"
          },
          "403": {
            "description": "RLS denied household access"
          }
        }
      }
    },
    "/households/{householdId}/timeline": {
      "get": {
        "operationId": "getLifeTimeline",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "householdId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "RLS-filtered obligation, deadline, document and task timeline"
          },
          "401": {
            "description": "Bearer token missing or invalid"
          },
          "404": {
            "description": "Household not found or not visible"
          },
          "503": {
            "description": "Persistence not configured"
          }
        }
      }
    },
    "/households/{householdId}/tasks/{taskId}/complete": {
      "post": {
        "operationId": "completeTask",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "householdId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task, deadline and obligation completed atomically; repeated calls replay state"
          },
          "401": {
            "description": "Bearer token missing or invalid"
          },
          "404": {
            "description": "Task not found or not visible"
          },
          "503": {
            "description": "Persistence not configured"
          }
        }
      }
    },
    "/home": {
      "get": {
        "operationId": "getHomeSummary",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "RLS-filtered LifeOS home status, coverage, counts and upcoming tasks"
          },
          "401": {
            "description": "Bearer token missing or invalid"
          },
          "503": {
            "description": "Persistence not configured"
          }
        }
      }
    },
    "/households/{householdId}/uploads/intents": {
      "post": {
        "operationId": "createDocumentUploadIntent",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "householdId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUploadIntentRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Private quarantined upload metadata intent created. No byte upload URL is returned until object storage is configured."
          },
          "400": {
            "description": "Unsafe filename, disallowed MIME type, invalid size, document type, person ID, or SHA-256."
          },
          "401": {
            "description": "Bearer token missing or invalid."
          },
          "404": {
            "description": "Household or person not found or not visible."
          },
          "503": {
            "description": "Persistence not configured."
          }
        }
      }
    },
    "/households/{householdId}/uploads": {
      "get": {
        "operationId": "listDocumentUploadIntents",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "householdId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owner-private upload metadata visible to the verified user."
          },
          "401": {
            "description": "Bearer token missing or invalid."
          },
          "404": {
            "description": "Household not found or not visible."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ExpiryProtectionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentType",
          "expiryDate"
        ],
        "properties": {
          "documentType": {
            "type": "string",
            "enum": [
              "passport",
              "identity_card",
              "driving_license",
              "insurance",
              "visa",
              "residence_permit",
              "vehicle_registration",
              "contract",
              "certificate",
              "other"
            ]
          },
          "expiryDate": {
            "type": "string",
            "format": "date"
          },
          "leadDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365,
            "default": 90
          }
        }
      },
      "PersistExpiryProtectionRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ExpiryProtectionRequest"
          },
          {
            "type": "object",
            "properties": {
              "personId": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        ]
      },
      "CreateUploadIntentRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fileName",
          "mimeType",
          "sizeBytes",
          "documentType"
        ],
        "properties": {
          "fileName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180,
            "description": "Base filename only. Path separators and NUL characters are rejected."
          },
          "mimeType": {
            "type": "string",
            "enum": [
              "application/pdf",
              "image/jpeg",
              "image/png",
              "image/heic",
              "image/webp"
            ]
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 26214400
          },
          "documentType": {
            "$ref": "#/components/schemas/ExpiryProtectionRequest/properties/documentType"
          },
          "personId": {
            "type": "string",
            "format": "uuid"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$",
            "description": "Optional client-declared SHA-256. Server verification occurs only after byte transport exists."
          }
        }
      }
    }
  }
}
