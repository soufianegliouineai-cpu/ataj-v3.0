{
  "name": "@lifeos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "verify": "npm run test",
    "test:integration": "npm run build && node --test --test-concurrency=1 dist/test/*.integration.test.js",
    "worker": "node dist/src/worker.js",
    "worker:once": "WORKER_ONCE=true node dist/src/worker.js",
    "scheduler": "node dist/src/scheduler.js",
    "scheduler:once": "SCHEDULER_ONCE=true node dist/src/scheduler.js",
    "notifier": "node dist/src/notifier.js",
    "notifier:once": "NOTIFICATION_ONCE=true node dist/src/notifier.js"
  },
  "dependencies": {
    "@azure/identity": "4.13.3",
    "@azure/storage-blob": "12.33.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "typescript": "7.0.2"
  }
}
