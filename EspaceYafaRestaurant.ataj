APP EspaceYafaRestaurant frontend react backend cloud

HAVE Restaurant id name address phone email description opening_hours average_rating total_reviews
HAVE MenuItem id name name_ar description_ar price category image_url available featured spiciness dietary_tags calories preparation_time
HAVE Customer id email name phone loyalty_points reservations_count last_visit
HAVE Order id customer_id restaurant_id items subtotal tax total status customer_name customer_phone delivery_address order_date
HAVE Reservation id customer_name customer_phone email party_size date time special_requests status table_number
HAVE Review id restaurant_id customer_id rating title comment created approved
HAVE Category id name name_ar icon display_order

SHOW Nav "Espace Yafa Restaurant" "Home Menu Reservations Order Reviews Contact" "black"

SHOW Hero "Authentic Moroccan Cuisine" "Casablanca Since 2020" "hero"
SHOW Button "View Menu" "primary" ON Click DO ShowMenu
SHOW Button "Book Table" "ghost" ON Click DO ShowReservations

SHOW Grid 3 6 "mobile:1"
SHOW Stat average_rating "Average Rating" "gold"
SHOW Stat total_reviews "Total Reviews" "secondary"
SHOW Card "Opening Hours" opening_hours "card"

SHOW Grid 1 3 "mobile:1"
FOR EACH item IN MenuItem WHEN item.available EQ true SHOW Card item.name item.price "card" ON Click DO AddToOrder item.id

SHOW Form "Reservation" "Name" "Phone" "Party Size" "Date" "Time" "Confirm Reservation" "primary" ON Submit DO CreateReservation

SHOW Form "Order" "Delivery Address" "Place Order" "primary" ON Submit DO CreateOrder

SHOW Form "Review" "Rating 1-5" "Title" "Comment" "Submit Review" "primary" ON Submit DO SubmitReview

SHOW Footer "Espace Yafa Restaurant 2026 Casablanca" "center gray"

DO GetRestaurantInfo
 DO DB.Query "SELECT * FROM restaurant WHERE id = 'espace-yafa-casa'"
 DO Cache.Set "restaurant:cache" 3600
 DO Emit restaurant.info_loaded

DO GetMenuItems
 DO DB.Query "SELECT * FROM menu_items WHERE available = true ORDER BY featured DESC"
 DO Cache.Set "menu:cache" 1800
 DO Emit menu.items_loaded

DO CreateReservation
 DO DB.Insert "reservations" Reservation
 DO Email.Send Reservation.email "reservation_confirmation"
 DO Audit.Log "RESERVATION_CREATED" Reservation.id
 DO Emit reservation.created

DO CreateOrder
 DO DB.Insert "orders" Order
 DO Audit.Log "ORDER_CREATED" Order.id
 DO Emit order.created

DO SubmitReview
 DO DB.Insert "reviews" Review
 DO Audit.Log "REVIEW_SUBMITTED" Review.id
 DO Emit review.submitted

DO AddToOrder
 DO Cart.Add item.id
 DO Emit cart.updated

WHEN 00:00 DO UpdateAnalytics
 DO DB.Query "UPDATE restaurant SET average_rating = (SELECT AVG(rating) FROM reviews WHERE approved = true)"
 DO DB.Query "UPDATE restaurant SET total_reviews = (SELECT COUNT(*) FROM reviews WHERE approved = true)"
 DO Emit analytics.updated